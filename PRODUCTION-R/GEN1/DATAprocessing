import pandas as pd
import MetaTrader5 as mt5
from datetime import datetime, timedelta

# Initialize MetaTrader5 connection
if not mt5.initialize():
    print("MetaTrader5 initialization failed")
    quit()

def fetch_mt5_data(symbol, timeframe, start_date, end_date):
    """
    Fetch OHLCV data from MetaTrader5.
    """
    rates = mt5.copy_rates_range(symbol, timeframe, start_date, end_date)
    if rates is None:
        print("Failed to fetch data from MT5.")
        return None

    df = pd.DataFrame(rates)
    df['time'] = pd.to_datetime(df['time'], unit='s')
    return df

def classify_candlestick(row):
    """
    Classifies candlestick patterns based on OHLC data.
    """
    open_price = row['open']
    high_price = row['high']
    low_price = row['low']
    close_price = row['close']

    body = abs(close_price - open_price)
    upper_shadow = high_price - max(open_price, close_price)
    lower_shadow = min(open_price, close_price) - low_price

    # Thresholds for classification (can be adjusted)
    body_threshold = 0.1 * (high_price - low_price)  # Small body threshold
    shadow_threshold = 2 * body  # Long shadow threshold

    if body <= body_threshold:
        if upper_shadow >= shadow_threshold and lower_shadow < shadow_threshold:
            return "Shooting Star"
        elif lower_shadow >= shadow_threshold and upper_shadow < shadow_threshold:
            return "Hammer"
        elif upper_shadow >= shadow_threshold and lower_shadow >= shadow_threshold:
            return "Doji"
        else:
            return "Spinning Top"
    else:
        if upper_shadow >= shadow_threshold and lower_shadow < shadow_threshold:
            return "Inverted Hammer"
        elif lower_shadow >= shadow_threshold and upper_shadow < shadow_threshold:
            return "Hanging Man"
        else:
            return "Normal"

def price_move_010(row):
    """
    Determines if the price moved 0.10% based on the candle type.
    """
    close_price = row['close']
    next_close_price = row['next_close']

    if pd.isna(next_close_price):
        return None

    price_change = (next_close_price - close_price) / close_price * 100
    return abs(price_change) >= 0.10

# Fetch data from MT5
symbol = "XAUUSDm"
timeframe = mt5.TIMEFRAME_H1

# Customize the date range here
start_date = datetime.now() - timedelta(days=3000)  # Fetch last 30 days by default
end_date = datetime.now()

ohlcv_data = fetch_mt5_data(symbol, timeframe, start_date, end_date)
if ohlcv_data is None:
    quit()

# Add a 'direction' column as labels (1 for up, 0 for down)
ohlcv_data['direction'] = (ohlcv_data['close'].shift(-1) > ohlcv_data['close']).astype(float)

# Add the candlestick type classification
ohlcv_data['candle_type'] = ohlcv_data.apply(classify_candlestick, axis=1)

# Add a column for the next close price
ohlcv_data['next_close'] = ohlcv_data['close'].shift(-1)

# Add the column to check if price moved 0.10%
ohlcv_data['price_move_010'] = ohlcv_data.apply(price_move_010, axis=1)

# Drop rows with NaNs
ohlcv_data.dropna(inplace=True)

# Save the updated DataFrame
data_output_path = r'd:\projects\MODELS\processed_ohlcv_data.txt'
ohlcv_data.to_csv(data_output_path, sep='\t', index=False)

print("Data processing complete. New file saved with candlestick types and price movement checks.")

# Shutdown MT5 connection
mt5.shutdown()
